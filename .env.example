# MedGuard AI - Environment Configuration
# Copy this file to .env and fill in your values.

# Database connection. SQLite is the local fallback; PostgreSQL for production.
DATABASE_URL=sqlite:///./medguard.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medguard

# AI provider settings
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector database (optional; local keyword retrieval is used when empty)
VECTOR_DATABASE_URL=

# Optional external drug-interaction API
DRUG_INTERACTION_API_KEY=

# Upload limits
MAX_UPLOAD_SIZE_MB=15

# Frontend API base URL (used by the Next.js client)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

